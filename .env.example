# 阿里云百炼（DashScope）API 密钥。复制本文件为 .env 后填写真实值。
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# DashScope 的 OpenAI 兼容接口地址。
DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# MinerU 异常页的千问多模态复核。结构化提取固定关闭思考模式。
QWEN_VL_MODEL=qwen3.8-max
QWEN_VL_ENABLE_THINKING=false

# 关闭 Chroma 匿名遥测。
ANONYMIZED_TELEMETRY=False

# 正式知识库持久化根目录。相对路径以项目根目录为基准。
RAG_STORAGE_ROOT=storage

# MinerU v4 精准解析 API。真实 Token 仅填写在本地 .env，禁止提交。
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_DEFAULT_MODEL=vlm
MINERU_HTML_MODEL=MinerU-HTML
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_MAX_BATCH_SIZE=50
MINERU_REQUEST_TIMEOUT_SECONDS=30
MINERU_UPLOAD_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_POLL_TIMEOUT_SECONDS=1800
