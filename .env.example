# 阿里云百炼（DashScope）API 密钥。复制本文件为 .env 后填写真实值。
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# DashScope 的 OpenAI 兼容接口地址。
DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# 节点5向量实验：同一份缓存同时供 Chroma 与 Qdrant 使用。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=10

# 节点5结论：当前默认使用 Chroma；Qdrant 保留为可切换后端，不做双写。
VECTOR_STORE=chroma
VECTOR_SCHEMA_VERSION=1
# 旧 rag 集合是 1024 维，请勿与当前 2048 维模型混用。
VECTOR_COLLECTION=rag_text_embedding_v4_2048

# Chroma 默认继续使用本地持久化目录；要连独立服务时改为 http。
CHROMA_MODE=local
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_HOST=127.0.0.1
CHROMA_PORT=18000
CHROMA_SSL=false
CHROMA_HNSW_M=32
CHROMA_HNSW_EF_CONSTRUCTION=200
CHROMA_HNSW_EF_SEARCH=200

# 仅当 VECTOR_STORE=qdrant 时连接，不会在 Chroma 模式下双写。
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCTION=200
QDRANT_HNSW_EF_SEARCH=300
QDRANT_INDEXING_THRESHOLD_KB=1000
QDRANT_FULL_SCAN_THRESHOLD_KB=10

# MinerU 异常页的千问多模态复核。结构化提取固定关闭思考模式。
QWEN_VL_MODEL=qwen3.8-max
QWEN_VL_ENABLE_THINKING=false

# 关闭 Chroma 匿名遥测。
ANONYMIZED_TELEMETRY=False

# 正式知识库持久化根目录。相对路径以项目根目录为基准。
RAG_STORAGE_ROOT=storage

# MinerU v4 精准解析 API。真实 Token 仅填写在本地 .env，禁止提交。
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_DEFAULT_MODEL=vlm
MINERU_HTML_MODEL=MinerU-HTML
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_MAX_BATCH_SIZE=50
MINERU_REQUEST_TIMEOUT_SECONDS=30
MINERU_UPLOAD_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_POLL_TIMEOUT_SECONDS=1800
